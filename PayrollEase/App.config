<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <connectionStrings>
        <!-- Name must stay "AppDB" (used by the csharf-classes AppDb class).
             Same service-based .mdf that Database.cs creates next to the .exe (bin\Debug). -->
        <add name="AppDB"
             connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\PayrollEaseDB.mdf;Integrated Security=True;Connect Timeout=30" />
    </connectionStrings>
</configuration>
